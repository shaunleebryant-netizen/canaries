//@version=6
indicator("MFI Washout", shorttitle = "MFI BF", overlay = false, max_labels_count = 500)

grpMfi = "MFI"
int   mfiLen      = input.int(14, "MFI length", minval = 1, group = grpMfi)
float osLevel     = input.float(30.0, "Oversold level", minval = 1.0, maxval = 50.0, step = 0.5, group = grpMfi)
int   osLookback  = input.int(10, "Oversold lookback (bars)", minval = 2, maxval = 50, group = grpMfi)
float resetLevel  = input.float(45.0, "Max MFI for signal", minval = 10.0, maxval = 70.0, step = 0.5, group = grpMfi)
bool  useRelative = input.bool(true, "Also arm on a relative MFI low", group = grpMfi, tooltip = "Arms when MFI is in the bottom portion of its lookback range, even if it never reached the fixed level.")
float relPct      = input.float(25.0, "Relative low: bottom % of range", minval = 5.0, maxval = 50.0, step = 1.0, group = grpMfi)
bool  requireHook = input.bool(true, "Require local hook (down then up)", group = grpMfi)
bool  useDiv      = input.bool(false, "Also allow bullish divergence", group = grpMfi, tooltip = "Price lower low, MFI higher low, while still armed.")
int   divLook     = input.int(8, "Divergence pivot lookback", minval = 2, maxval = 30, group = grpMfi)

grpVol = "Volume filter"
bool  useVolFilter    = input.bool(true, "Use volume climax + contraction", group = grpVol)
int   volLen          = input.int(20, "Volume SMA length", minval = 1, group = grpVol)
float volClimaxMult   = input.float(1.3, "Climax multiple vs SMA", minval = 1.0, step = 0.1, group = grpVol)
int   climaxLookback  = input.int(6, "Climax must occur within (bars)", minval = 1, maxval = 30, group = grpVol)
bool  requireContract = input.bool(true, "Require volume contraction on turn", group = grpVol)

grpVis = "Visuals"
bool  showMfi     = input.bool(true, "Show MFI", group = grpVis)
bool  colorMfi    = input.bool(true, "Color MFI by slope", group = grpVis)
bool  showBg      = input.bool(true, "Highlight oversold zone", group = grpVis)
bool  markOnPane  = input.bool(true, "Markers on MFI pane", group = grpVis)
bool  markOnPrice = input.bool(true, "Markers on price chart", group = grpVis)
color colMfiUp    = input.color(color.new(#26a69a, 0), "MFI rising", group = grpVis)
color colMfiDn    = input.color(color.new(#ef5350, 0), "MFI falling", group = grpVis)
color colSignal   = input.color(color.new(#00e676, 0), "Bottom signal", group = grpVis)
color colOs       = input.color(color.new(#26a69a, 88), "Oversold fill", group = grpVis)

float mfi = ta.mfi(hlc3, mfiLen)
bool  hasVolume = nz(volume) > 0
bool  ready = not na(mfi) and hasVolume

bool mfiRising = ready and mfi > mfi[1]
bool mfiHook   = ready and mfi > mfi[1] and mfi[1] <= mfi[2]
bool rawTurn   = requireHook ? mfiHook : mfiRising

float mfiLo  = ta.lowest(mfi, osLookback)
float mfiHi  = ta.highest(mfi, osLookback)
float mfiRng = math.max(mfiHi - mfiLo, 0.01)
bool absOs   = ready and mfiLo <= osLevel
bool relOs   = ready and useRelative and (mfi - mfiLo) / mfiRng * 100.0 <= relPct
bool osZone  = absOs or relOs
bool stillLow = ready and mfi <= resetLevel

float volSma = ta.sma(volume, volLen)
bool barClimax = nz(volume) >= nz(volSma) * volClimaxMult
bool climaxInWindow = not na(ta.barssince(barClimax)) and ta.barssince(barClimax) <= climaxLookback
bool contracted = nz(volume) <= nz(volume[1])
bool volOk = not useVolFilter or (climaxInWindow and (not requireContract or contracted))

bool priceLL = ta.lowest(low, divLook) < ta.lowest(low, divLook)[divLook]
bool mfiHL   = ta.lowest(mfi, divLook) > ta.lowest(mfi, divLook)[divLook]
bool divOk   = useDiv and priceLL and mfiHL and stillLow

var bool armed = false
if osZone
    armed := true
if ready and mfi > resetLevel
    armed := false

bool bottomSignal = ready and armed and stillLow and volOk and (rawTurn or divOk)

if bottomSignal
    armed := false

color mfiCol = colorMfi ? (mfiRising ? colMfiUp : colMfiDn) : colMfiUp
plot(showMfi ? mfi : na, "MFI", mfiCol, 2)

hOs    = hline(osLevel, "Oversold", color.new(#26a69a, 20), hline.style_dashed)
hReset = hline(resetLevel, "Reset / max signal", color.new(#787b86, 30), hline.style_dotted)
hMid   = hline(50.0, "Mid", color.new(#787b86, 55), hline.style_dotted)
hOb    = hline(80.0, "Overbought", color.new(#ef5350, 40), hline.style_dashed)
fill(hOs, hline(0.0, display = display.none), showBg ? colOs : na)

plotshape(markOnPane and bottomSignal, "Bottom (pane)", shape.triangleup, location.bottom, colSignal, size = size.small)
if markOnPrice and bottomSignal
    label.new(bar_index, low, "💵", yloc = yloc.belowbar, style = label.style_none, textcolor = colSignal, size = size.normal, force_overlay = true)
bgcolor(showBg and ready and (mfi <= osLevel or relOs) ? colOs : na, title = "Oversold background")

var table warn = table.new(position.top_right, 1, 1)
if barstate.islast and not hasVolume
    table.cell(warn, 0, 0, "MFI needs volume — this symbol has none", text_color = color.white, bgcolor = color.new(color.red, 20))
else if barstate.islast
    table.clear(warn, 0, 0)

alertcondition(bottomSignal, "MFI bottom", "MFI bottom finder fired on {{ticker}} @ {{close}}")
if bottomSignal
    alert("MFI bottom finder: " + syminfo.ticker + " @ " + str.tostring(close), alert.freq_once_per_bar_close)
